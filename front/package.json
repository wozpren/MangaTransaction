{
	"name": "mangatransaction",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "concurrently -n front,ocr -c blue,green \"pnpm run dev:front\" \"pnpm run dev:ocr\"",
		"dev:front": "vite dev",
		"dev:ocr": "python -m uvicorn server.ocr_server:app --host 0.0.0.0 --port 8787 --app-dir ..",
		"setup:model": "node ../scripts/download-model.mjs",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.50.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/vite": "^4.2.1",
		"concurrently": "^9.2.1",
		"svelte": "^5.51.0",
		"tailwindcss": "^4.2.1",
		"vite": "^7.3.1"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild"
		]
	},
	"dependencies": {
		"@google/genai": "^1.45.0",
		"@huggingface/transformers": "^3.8.1",
		"fabric": "^7.2.0",
		"html-to-image": "^1.11.13",
		"html2canvas": "^1.4.1",
		"idb-keyval": "^6.2.2",
		"lucide-svelte": "^0.577.0",
		"modern-screenshot": "^4.6.8",
		"onnxruntime-node": "^1.24.3",
		"onnxruntime-web": "^1.24.3",
		"sharp": "^0.34.5",
		"toastify-js": "^1.12.0"
	}
}
